<Window x:Class="Bn_s_Launcher.VersionBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Escolher versao"
        Icon="/Assets/bn-logo.ico"
        Width="980"
        Height="720"
        MinWidth="860"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F12"
        WindowStyle="None"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#D711171D" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF5F4EC" />
            <Setter Property="Background" Value="#1A000000" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" MouseLeftButtonDown="HeaderBorder_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/bn-logo.png"
                               Width="28"
                               Height="28"
                               Margin="0,0,12,0"
                               Stretch="Uniform" />
                        <TextBlock Text="Pagina de versoes"
                                   Foreground="#FFF7F7F0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   FontFamily="Bahnschrift" />
                    </StackPanel>
                    <TextBlock Text="Escolha uma versao release, snapshot, beta ou alfa para a instancia."
                               Foreground="#BCD8D0C4"
                               Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="SearchTextBox"
                             Width="260"
                             Margin="0,0,14,0"
                             Padding="12,10"
                             Background="#1A000000"
                             Foreground="#FFF5F4EC"
                             BorderBrush="#30FFFFFF"
                             BorderThickness="1"
                             TextChanged="SearchTextBox_TextChanged" />
                    <Button Content="Atualizar"
                            Click="RefreshButton_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,10,0" />
                    <Button Content="Fechar"
                            Click="CancelButton_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Filtros" Foreground="#FFF7F7F0" FontSize="20" FontWeight="SemiBold" />
                    <CheckBox x:Name="ReleaseCheckBox" Content="Releases" Foreground="#FFF5F4EC" Margin="0,18,0,8" IsChecked="True" Checked="FilterCheckBox_Changed" Unchecked="FilterCheckBox_Changed" />
                    <CheckBox x:Name="SnapshotCheckBox" Content="Snapshots" Foreground="#FFF5F4EC" Margin="0,0,0,8" IsChecked="True" Checked="FilterCheckBox_Changed" Unchecked="FilterCheckBox_Changed" />
                    <CheckBox x:Name="BetaCheckBox" Content="Betas" Foreground="#FFF5F4EC" Margin="0,0,0,8" IsChecked="False" Checked="FilterCheckBox_Changed" Unchecked="FilterCheckBox_Changed" />
                    <CheckBox x:Name="AlphaCheckBox" Content="Alfas" Foreground="#FFF5F4EC" IsChecked="False" Checked="FilterCheckBox_Changed" Unchecked="FilterCheckBox_Changed" />
                    <TextBlock x:Name="FilterSummaryTextBlock"
                               Foreground="#A5E7D7BF"
                               Margin="0,24,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="StatusTextBlock"
                               Foreground="#BCD8D0C4"
                               Text="Carregando versoes..." />
                    <ListView x:Name="VersionsListView"
                              Grid.Row="1"
                              Margin="0,16,0,0"
                              MouseDoubleClick="VersionsListView_MouseDoubleClick"
                              SelectionChanged="VersionsListView_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Versao" Width="220" DisplayMemberBinding="{Binding Id}" />
                                <GridViewColumn Header="Tipo" Width="120" DisplayMemberBinding="{Binding Type}" />
                                <GridViewColumn Header="Badge" Width="140" DisplayMemberBinding="{Binding Badge}" />
                                <GridViewColumn Header="Lancado" Width="180" DisplayMemberBinding="{Binding ReleaseLabel}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SelectedVersionTextBlock"
                               Foreground="#FFF7F7F0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="Nenhuma versao selecionada" />
                    <TextBlock x:Name="SelectedVersionMetaTextBlock"
                               Foreground="#A5E7D7BF"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cancelar" Click="CancelButton_Click" Style="{StaticResource ActionButtonStyle}" />
                    <Button x:Name="SelectButton"
                            Content="Selecionar versao"
                            Click="SelectButton_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            IsEnabled="False"
                            Margin="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
