<Window x:Class="Bn_s_Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Bn's Launcher"
        Icon="/Assets/bn-logo.ico"
        Width="1480"
        Height="900"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#06080D"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowState="Maximized"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="ThemePrimaryTextBrush" Color="#FFF7FAFF" />
        <SolidColorBrush x:Key="ThemeMutedTextBrush" Color="#C6B7C3D3" />
        <SolidColorBrush x:Key="ThemeLabelTextBrush" Color="#A69FC0FF" />
        <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#B012141A" />
        <SolidColorBrush x:Key="ThemeCardBorderBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="ThemeButtonBackgroundBrush" Color="#140D1117" />
        <SolidColorBrush x:Key="ThemeButtonBorderBrush" Color="#30FFFFFF" />
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#0F6BFF" />
        <SolidColorBrush x:Key="ThemeAccentSoftBrush" Color="#550F6BFF" />
        <SolidColorBrush x:Key="ThemeFieldBackgroundBrush" Color="#FFF5F5F5" />
        <SolidColorBrush x:Key="ThemeFieldForegroundBrush" Color="#FF101010" />
        <SolidColorBrush x:Key="ThemeFieldBorderBrush" Color="#FFB8B8B8" />
        <SolidColorBrush x:Key="ThemeListBackgroundBrush" Color="#120C1016" />
        <SolidColorBrush x:Key="ThemeListForegroundBrush" Color="#FFF5F4EC" />
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="FieldStyle" TargetType="Control">
            <Setter Property="Foreground" Value="{DynamicResource ThemeFieldForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeFieldBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeFieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="DarkListStyle" TargetType="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeListForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeListBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="LaunchButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground" Value="#07110D" />
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
        <Style x:Key="ChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeFieldForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeFieldBackgroundBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ThemeFieldForegroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeListForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="#FF363636" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkScrollRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Background" Value="#FF090B0A" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkVerticalScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="14" />
            <Setter Property="Background" Value="#FF090B0A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}"
                              Width="{TemplateBinding Width}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="16" />
                            </Grid.RowDefinitions>
                            <RepeatButton Grid.Row="0"
                                          Command="ScrollBar.LineUpCommand"
                                          Style="{StaticResource DarkScrollRepeatButtonStyle}" />
                            <Track x:Name="PART_Track"
                                   Grid.Row="1"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource DarkScrollRepeatButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource DarkScrollRepeatButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                            <RepeatButton Grid.Row="2"
                                          Command="ScrollBar.LineDownCommand"
                                          Style="{StaticResource DarkScrollRepeatButtonStyle}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="WindowBackgroundStartStop" Color="#05070C" Offset="0" />
                <GradientStop x:Name="WindowBackgroundMiddleStop" Color="#111827" Offset="0.55" />
                <GradientStop x:Name="WindowBackgroundEndStop" Color="#04060A" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="GlowPrimaryEllipse" Width="380" Height="380" Canvas.Left="-120" Canvas.Top="-120" Fill="#18437DFF" />
            <Ellipse x:Name="GlowSecondaryEllipse" Width="420" Height="420" Canvas.Right="-140" Canvas.Top="80" Fill="#122B4FD8" />
            <Ellipse x:Name="GlowTertiaryEllipse" Width="280" Height="280" Canvas.Left="980" Canvas.Bottom="-60" Fill="#10437DFF" />
        </Canvas>

        <Border x:Name="ShellBorder" Margin="0" Background="#F007100D" BorderBrush="#163C4843" BorderThickness="1" CornerRadius="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="TitleBarBorder" Grid.Row="0"
                        Background="#F40A120F"
                        BorderBrush="#183C4843"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBarBorder_MouseLeftButtonDown">
                    <Grid Margin="20,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <Border Width="38"
                                    Height="38"
                                    CornerRadius="12"
                                    Background="#16000000"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1"
                                    Margin="0,0,14,0">
                                <Image Source="/Assets/bn-logo.png"
                                       Width="24"
                                       Height="24"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Bn's Launcher"
                                           Foreground="{DynamicResource ThemePrimaryTextBrush}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           FontFamily="Bahnschrift" />
                                <TextBlock Text="Vanilla, Forge, OptiFine e personalizacao rapida"
                                           Foreground="{DynamicResource ThemeMutedTextBrush}"
                                           FontSize="12" />
                            </StackPanel>
                        </StackPanel>

                        <WrapPanel Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <Border Background="#12000000"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Padding="12,6"
                                    Margin="0,0,10,0">
                                <TextBlock Foreground="{DynamicResource ThemePrimaryTextBrush}"
                                           Text="Offline e Microsoft" />
                            </Border>
                            <Border Background="#12000000"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Padding="12,6"
                                    Margin="0,0,10,0">
                                <TextBlock Foreground="{DynamicResource ThemePrimaryTextBrush}"
                                           Text="Temas rapidos" />
                            </Border>
                            <Border Background="#12000000"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Padding="12,6">
                                <TextBlock Foreground="{DynamicResource ThemePrimaryTextBrush}"
                                           Text="F11 tela cheia" />
                            </Border>
                            <TextBlock x:Name="WindowModeBadgeTextBlock"
                                       Visibility="Collapsed" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                            <Button Content="F11" Click="FullscreenButton_Click" Style="{StaticResource ChromeButtonStyle}" />
                            <Button Content="_" Click="MinimizeButton_Click" Style="{StaticResource ChromeButtonStyle}" />
                            <Button x:Name="MaximizeWindowButton" Content="[]" Click="MaximizeWindowButton_Click" Style="{StaticResource ChromeButtonStyle}" />
                            <Button Content="X" Click="CloseWindowButton_Click" Style="{StaticResource ChromeButtonStyle}" Margin="0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Bn's Launcher" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontSize="32" FontWeight="Bold" FontFamily="Bahnschrift" />
                        <TextBlock Grid.Row="1" Text="Launcher de Minecraft com perfis, instancias separadas, conta offline ou Microsoft e painel de noticias." Foreground="{DynamicResource ThemeMutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,24" />

                        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Border x:Name="PreviewBackgroundLayer" CornerRadius="18" />
                                <Border Background="#8A07120F" CornerRadius="18" />
                                <StackPanel Margin="18">
                                    <TextBlock Text="PREVIEW" Foreground="#FFE8D8B0" FontWeight="Bold" FontSize="11" />
                                    <TextBlock x:Name="PreviewProfileTextBlock" Text="SteveBn" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontSize="28" FontWeight="Bold" FontFamily="Bahnschrift" Margin="0,34,0,6" />
                                    <TextBlock x:Name="PreviewStatusTextBlock" Text="Pronto para iniciar" Foreground="#DCEEE4DB" TextWrapping="Wrap" />
                                    <Border x:Name="PreviewAccentBar" Height="8" CornerRadius="999" Background="#0F6BFF" Margin="0,18,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3"
                                Style="{StaticResource CardStyle}"
                                Margin="0,0,0,12"
                                VerticalAlignment="Stretch">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Background="#FF090B0A"
                                          Padding="0">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkVerticalScrollBarStyle}" />
                                </ScrollViewer.Resources>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Resumo" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Perfil" Foreground="#8BEBD5BB" Margin="0,16,0,4" />
                                    <TextBlock x:Name="SummaryProfileValueTextBlock" Foreground="{DynamicResource ThemePrimaryTextBrush}" />
                                    <TextBlock Text="Instancia" Foreground="#8BEBD5BB" Margin="0,14,0,4" />
                                    <TextBlock x:Name="SummaryInstanceValueTextBlock" Foreground="{DynamicResource ThemePrimaryTextBrush}" />
                                    <TextBlock Text="Versao" Foreground="#8BEBD5BB" Margin="0,14,0,4" />
                                    <TextBlock x:Name="SummaryVersionValueTextBlock" Foreground="{DynamicResource ThemePrimaryTextBrush}" />
                                    <TextBlock Text="Memoria" Foreground="#8BEBD5BB" Margin="0,14,0,4" />
                                    <TextBlock x:Name="SummaryMemoryValueTextBlock" Foreground="{DynamicResource ThemePrimaryTextBrush}" />
                                    <TextBlock Text="Pasta" Foreground="#8BEBD5BB" Margin="0,14,0,4" />
                                    <TextBlock x:Name="SummaryTargetValueTextBlock" Foreground="{DynamicResource ThemePrimaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Button Grid.Row="4" x:Name="LaunchButton" Content="Iniciar Minecraft" Click="LaunchButton_Click" Style="{StaticResource LaunchButtonStyle}" />
                        <Button Grid.Row="5" Content="Abrir pasta da instancia" Click="OpenGameFolderButton_Click" Style="{StaticResource ActionButtonStyle}" />
                        <ProgressBar Grid.Row="6"
                                     x:Name="LaunchProgressBar"
                                     Height="8"
                                     Margin="0,2,0,0"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Foreground="#0F6BFF"
                                     Background="#22000000" />
                        <StackPanel Grid.Row="7" Margin="0,8,0,0">
                            <TextBlock x:Name="StatusTextBlock" Foreground="#E2F3E7D9" TextWrapping="Wrap" />
                            <TextBlock Text="Ultimo launch"
                                       Foreground="#8BEBD5BB"
                                       Margin="0,10,0,4" />
                            <TextBlock x:Name="LastLaunchValueTextBlock"
                                       Foreground="{DynamicResource ThemePrimaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <TextBlock Text="Jogar rapido, personalizar facil" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontSize="34" FontWeight="Bold" FontFamily="Bahnschrift" />
                            <TextBlock Text="Monte o launcher do seu jeito, troque tema sem travar e escolha a melhor combinacao entre Vanilla, Forge e OptiFine." Foreground="{DynamicResource ThemeMutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,22" />

                            <WrapPanel Margin="0,0,0,12">
                                <Border Background="#1DFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="999" Padding="14,8" Margin="0,0,10,10"><TextBlock x:Name="HeaderProfileBadgeTextBlock" Foreground="{DynamicResource ThemePrimaryTextBrush}" Text="Perfil principal" /></Border>
                                <Border Background="#1DFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="999" Padding="14,8" Margin="0,0,10,10"><TextBlock x:Name="HeaderInstanceBadgeTextBlock" Foreground="{DynamicResource ThemePrimaryTextBrush}" Text="Instancia principal" /></Border>
                                <Border Background="#1DFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="999" Padding="14,8" Margin="0,0,10,10"><TextBlock x:Name="HeaderVersionBadgeTextBlock" Foreground="{DynamicResource ThemePrimaryTextBrush}" Text="Vanilla 1.21.x" /></Border>
                                <Border Background="#1DFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="999" Padding="14,8" Margin="0,0,10,10"><TextBlock x:Name="HeaderMemoryBadgeTextBlock" Foreground="{DynamicResource ThemePrimaryTextBrush}" Text="4096 MB" /></Border>
                            </WrapPanel>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,16">
                                    <StackPanel>
                                        <TextBlock Text="Perfis" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontSize="20" FontWeight="SemiBold" />
                                        <ListBox x:Name="ProfilesListBox" Style="{StaticResource DarkListStyle}" DisplayMemberPath="Name" SelectionChanged="ProfilesListBox_SelectionChanged" Height="180" Margin="0,14,0,12" />
                                        <WrapPanel><Button Content="Novo perfil" Click="AddProfileButton_Click" Style="{StaticResource ActionButtonStyle}" /><Button Content="Duplicar" Click="DuplicateProfileButton_Click" Style="{StaticResource ActionButtonStyle}" /><Button Content="Excluir" Click="DeleteProfileButton_Click" Style="{StaticResource ActionButtonStyle}" /></WrapPanel>
                                        <TextBlock Text="Nome do perfil" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,4,0,8" />
                                        <TextBox x:Name="ProfilePresetNameTextBox" Style="{StaticResource FieldStyle}" Padding="12,10" TextChanged="AnySettingChanged" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Instancias" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontSize="20" FontWeight="SemiBold" />
                                        <ListBox x:Name="InstancesListBox" Style="{StaticResource DarkListStyle}" DisplayMemberPath="Name" SelectionChanged="InstancesListBox_SelectionChanged" Height="180" Margin="0,14,0,12" />
                                        <WrapPanel><Button Content="Nova instancia" Click="AddInstanceButton_Click" Style="{StaticResource ActionButtonStyle}" /><Button Content="Duplicar" Click="DuplicateInstanceButton_Click" Style="{StaticResource ActionButtonStyle}" /><Button Content="Excluir" Click="DeleteInstanceButton_Click" Style="{StaticResource ActionButtonStyle}" /></WrapPanel>
                                        <TextBlock Text="Nome da instancia" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,4,0,8" />
                                        <TextBox x:Name="InstanceNameTextBox" Style="{StaticResource FieldStyle}" Padding="12,10" Margin="0,0,0,12" TextChanged="AnySettingChanged" />
                                        <TextBlock Text="Observacoes" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,0,0,8" />
                                        <TextBox x:Name="InstanceNotesTextBox" Style="{StaticResource FieldStyle}" Padding="12,10" Height="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" TextChanged="AnySettingChanged" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Configuracoes do perfil ativo" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontSize="20" FontWeight="SemiBold" />

                                        <TextBlock Text="Tipo de conta" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,18,0,8" />
                                        <ComboBox x:Name="AccountModeComboBox"
                                                  Style="{StaticResource FieldStyle}"
                                                  Padding="10,8"
                                                  Margin="0,0,0,14"
                                                  SelectionChanged="AccountModeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="offline" />
                                            <ComboBoxItem Content="microsoft" />
                                        </ComboBox>

                                        <Border Background="#12000000" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Conta atual" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontWeight="SemiBold" />
                                                <TextBlock x:Name="AccountStatusTextBlock" Foreground="{DynamicResource ThemeMutedTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,12,0,0">
                                                    <Button x:Name="MicrosoftLoginButton" Content="Entrar com Microsoft" Click="MicrosoftLoginButton_Click" Style="{StaticResource ActionButtonStyle}" />
                                                    <Button x:Name="MicrosoftLogoutButton" Content="Sair da conta" Click="MicrosoftLogoutButton_Click" Style="{StaticResource ActionButtonStyle}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock x:Name="PlayerNameLabelTextBlock" Text="Nick pirata / offline" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,0,0,8" />
                                        <TextBox x:Name="PlayerNameTextBox" Style="{StaticResource FieldStyle}" Padding="12,10" Margin="0,0,0,14" TextChanged="AnySettingChanged" />
                                        <TextBlock Text="Tema do launcher" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,0,0,8" />
                                        <ComboBox x:Name="ThemePresetComboBox"
                                                  Style="{StaticResource FieldStyle}"
                                                  Padding="10,8"
                                                  Margin="0,0,0,14"
                                                  Visibility="Collapsed"
                                                  SelectionChanged="ThemePresetComboBox_SelectionChanged">
                                            <ComboBoxItem Content="preto + azul" />
                                            <ComboBoxItem Content="preto + branco" />
                                            <ComboBoxItem Content="preto + vermelho" />
                                            <ComboBoxItem Content="custom" />
                                        </ComboBox>
                                        <WrapPanel Margin="0,0,0,14">
                                            <Button Content="Azul forte" Tag="preto + azul" Click="ThemeQuickButton_Click" Style="{StaticResource ActionButtonStyle}" />
                                            <Button Content="Branco forte" Tag="preto + branco" Click="ThemeQuickButton_Click" Style="{StaticResource ActionButtonStyle}" />
                                            <Button Content="Vermelho forte" Tag="preto + vermelho" Click="ThemeQuickButton_Click" Style="{StaticResource ActionButtonStyle}" />
                                        </WrapPanel>
                                        <TextBlock Text="Cor custom" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,0,0,8" />
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="AccentColorTextBox" Style="{StaticResource FieldStyle}" Padding="12,10" Margin="0" TextChanged="AnySettingChanged" />
                                            <Border x:Name="AccentSwatchBorder"
                                                    Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    CornerRadius="14"
                                                    BorderBrush="#26FFFFFF"
                                                    BorderThickness="1"
                                                    Background="#0F6BFF"
                                                    Cursor="Hand"
                                                    ToolTip="Clique para abrir o seletor de cor."
                                                    MouseLeftButtonUp="AccentSwatchBorder_MouseLeftButtonUp" />
                                        </Grid>
                                        <TextBlock Text="Imagem de fundo" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="BackgroundImageTextBox" Style="{StaticResource FieldStyle}" Padding="12,10" Margin="0" TextChanged="AnySettingChanged" />
                                            <Button Grid.Column="1" Content="Escolher" Click="BackgroundBrowseButton_Click" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Memoria maxima" Foreground="{DynamicResource ThemeLabelTextBrush}" />
                                            <TextBlock x:Name="MemoryValueTextBlock" Grid.Column="1" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontWeight="SemiBold" Text="4096 MB" />
                                        </Grid>
                                        <Slider x:Name="MemorySlider" Minimum="1024" Maximum="16384" TickFrequency="512" IsSnapToTickEnabled="True" ValueChanged="MemorySlider_ValueChanged" Margin="0,0,0,18" />
                                        <TextBlock Text="Argumentos JVM" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,0,0,8" />
                                        <TextBox x:Name="JvmArgumentsTextBox" Style="{StaticResource FieldStyle}" Padding="12,10" Margin="0,0,0,14" Height="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" TextChanged="AnySettingChanged" />
                                        <TextBlock Text="Argumentos do jogo" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,0,0,8" />
                                        <TextBox x:Name="GameArgumentsTextBox" Style="{StaticResource FieldStyle}" Padding="12,10" Height="82" Margin="0,0,0,14" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" TextChanged="AnySettingChanged" />
                                        <CheckBox x:Name="FullScreenCheckBox" Content="Adicionar --fullscreen automaticamente" Foreground="{DynamicResource ThemePrimaryTextBrush}" Margin="0,0,0,10" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
                                        <CheckBox x:Name="CloseOnLaunchCheckBox" Content="Fechar o launcher depois do launch" Foreground="{DynamicResource ThemePrimaryTextBrush}" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Configuracoes da instancia ativa" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="Origem da versao" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,18,0,8" />
                                        <ComboBox x:Name="VersionSourceComboBox"
                                                  Style="{StaticResource FieldStyle}"
                                                  Padding="10,8"
                                                  Margin="0,0,0,8"
                                                  SelectionChanged="VersionSourceComboBox_SelectionChanged">
                                            <ComboBoxItem Content="catalogo oficial" />
                                            <ComboBoxItem Content="custom/local" />
                                        </ComboBox>
                                        <TextBlock x:Name="CustomVersionHintTextBlock"
                                                   Foreground="{DynamicResource ThemeMutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12"
                                                   Text="Use o catalogo para baixar versoes oficiais ou troque para custom/local para iniciar um ID que ja exista na pasta versions." />
                                        <TextBlock Text="Versao do Minecraft" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,18,0,8" />
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="VersionIdTextBox"
                                                     Style="{StaticResource FieldStyle}"
                                                     Padding="12,10"
                                                     Margin="0"
                                                     TextChanged="AnySettingChanged" />
                                            <Button x:Name="OpenVersionsButton"
                                                    Grid.Column="1"
                                                    Content="Catalogo de versoes"
                                                    Click="OpenVersionsButton_Click"
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    Margin="10,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="Tipo da versao" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,0,0,8" />
                                        <ComboBox x:Name="VersionTypeComboBox"
                                                  Style="{StaticResource FieldStyle}"
                                                  Padding="10,8"
                                                  Margin="0,0,0,14"
                                                  SelectionChanged="AnySettingChanged">
                                            <ComboBoxItem Content="release" />
                                            <ComboBoxItem Content="snapshot" />
                                            <ComboBoxItem Content="old_beta" />
                                            <ComboBoxItem Content="old_alpha" />
                                        </ComboBox>
                                        <TextBlock Text="Loader / otimizacao" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,0,0,8" />
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="LoaderKindComboBox"
                                                      Style="{StaticResource FieldStyle}"
                                                      Padding="10,8"
                                                      Margin="0"
                                                      SelectionChanged="LoaderKindComboBox_SelectionChanged">
                                                <ComboBoxItem Content="vanilla" />
                                                <ComboBoxItem Content="forge" />
                                                <ComboBoxItem Content="optifine" />
                                                <ComboBoxItem Content="forge+optifine" />
                                            </ComboBox>
                                            <Button x:Name="RefreshLoadersButton"
                                                    Grid.Column="1"
                                                    Content="Atualizar"
                                                    Click="RefreshLoadersButton_Click"
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    Margin="10,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="Build do Forge" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,0,0,8" />
                                        <ComboBox x:Name="ForgeVersionComboBox"
                                                  Style="{StaticResource FieldStyle}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Id"
                                                  Padding="10,8"
                                                  Margin="0,0,0,6"
                                                  SelectionChanged="LoaderBuildComboBox_SelectionChanged" />
                                        <TextBlock x:Name="ForgeVersionMetaTextBlock"
                                                   Foreground="{DynamicResource ThemeMutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12" />
                                        <TextBlock Text="Build do OptiFine" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,0,0,8" />
                                        <ComboBox x:Name="OptifineVersionComboBox"
                                                  Style="{StaticResource FieldStyle}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Id"
                                                  Padding="10,8"
                                                  Margin="0,0,0,6"
                                                  SelectionChanged="LoaderBuildComboBox_SelectionChanged" />
                                        <TextBlock x:Name="OptifineVersionMetaTextBlock"
                                                   Foreground="{DynamicResource ThemeMutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12" />
                                        <TextBlock x:Name="LoaderStatusTextBlock"
                                                   Foreground="{DynamicResource ThemeMutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="Depois do primeiro download, o launcher reutiliza a versao preparada para abrir mais rapido." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Modo da pasta do jogo" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,18,0,8" />
                                        <ComboBox x:Name="GameDirectoryModeComboBox"
                                                  Style="{StaticResource FieldStyle}"
                                                  Padding="10,8"
                                                  Margin="0,0,0,8"
                                                  SelectionChanged="GameDirectoryModeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="instancia separada" />
                                            <ComboBoxItem Content=".minecraft padrao" />
                                        </ComboBox>
                                        <TextBlock x:Name="GameDirectoryModeHintTextBlock"
                                                   Foreground="{DynamicResource ThemeMutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12"
                                                   Text="Instancia separada cria uma pasta so para esta instancia. O modo .minecraft usa a pasta padrao do launcher oficial." />
                                        <TextBlock Text="Pasta do jogo" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,0,0,8" />
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="GameDirectoryTextBox" Style="{StaticResource FieldStyle}" Padding="12,10" Margin="0" TextChanged="AnySettingChanged" />
                                            <Button x:Name="GameDirectoryBrowseButton" Grid.Column="1" Content="Escolher" Click="GameDirectoryBrowseButton_Click" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="Java (opcional)" Foreground="{DynamicResource ThemeLabelTextBrush}" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="JavaPathTextBox" Style="{StaticResource FieldStyle}" Padding="12,10" Margin="0" TextChanged="AnySettingChanged" />
                                            <Button Grid.Column="1" Content="Escolher" Click="JavaBrowseButton_Click" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Noticias e atualizacoes" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock x:Name="NewsStatusTextBlock" Foreground="{DynamicResource ThemeMutedTextBrush}" Margin="0,8,0,14" Text="Carregando painel..." />
                                        <ListBox x:Name="NewsListBox" Style="{StaticResource DarkListStyle}" DisplayMemberPath="Title" SelectionChanged="NewsListBox_SelectionChanged" Height="220" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button x:Name="RefreshNewsButton" Content="Atualizar noticias" Click="RefreshNewsButton_Click" Style="{StaticResource ActionButtonStyle}" />
                                            <Button x:Name="OpenNewsButton" Content="Abrir noticia" Click="OpenNewsButton_Click" Style="{StaticResource ActionButtonStyle}" />
                                            <Button Content="Site oficial" Click="OpenOfficialSiteButton_Click" Style="{StaticResource ActionButtonStyle}" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#11000000" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="16" Padding="16">
                                        <StackPanel>
                                            <TextBlock x:Name="NewsTitleTextBlock" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" Text="Selecione uma noticia" />
                                            <TextBlock x:Name="NewsMetaTextBlock" Foreground="#90E8D7C0" Margin="0,8,0,10" TextWrapping="Wrap" />
                                            <TextBlock x:Name="NewsSummaryTextBlock" Foreground="#D3E7DFD5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Config salvo em" Foreground="{DynamicResource ThemeLabelTextBrush}" />
                                    <TextBlock x:Name="FooterPathTextBlock" Foreground="{DynamicResource ThemePrimaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
                                    <WrapPanel>
                                        <Button Content="Salvar agora" Click="SaveButton_Click" Style="{StaticResource ActionButtonStyle}" />
                                        <Button Content="Restaurar padrao" Click="ResetButton_Click" Style="{StaticResource ActionButtonStyle}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
